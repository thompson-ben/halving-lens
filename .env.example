# ---------------------------------------------------------------------------
# Supercar Content Engine — environment variables
# Copy this file to `.env.local` and fill in real values for local development.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# ---- Application -----------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Supercar Content Engine"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Toggle to fall back to mock data if external APIs are unavailable.
USE_MOCK_DATA=true

# ---- Database --------------------------------------------------------------
# PostgreSQL (Supabase / Neon / RDS / local). The Prisma schema uses String[]
# and Json columns, so Postgres is required as-is. To use SQLite locally,
# switch `provider` in prisma/schema.prisma and replace String[] / Json
# columns with their SQLite-compatible equivalents.
DATABASE_URL="postgresql://user:password@localhost:5432/supercar_engine?schema=public"

# Supabase (optional; only required if using Supabase auth / storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Meta / Instagram Graph API --------------------------------------------
# See META_API_SETUP.md for the full guided walkthrough.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Long-lived user access token (server-side only). Rotate regularly.
INSTAGRAM_ACCESS_TOKEN=
# Instagram Business Account ID (numeric).
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Facebook Page ID that the IG Business Account is connected to.
FACEBOOK_PAGE_ID=

# ---- Optional: queue / scheduling ------------------------------------------
REDIS_URL=
# Secret for verifying cron jobs that trigger /api/cron/*
CRON_SECRET=

# ---- Optional source connectors --------------------------------------------
# TikTok (Display API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube Data API v3
YOUTUBE_API_KEY=

# X / Twitter API v2 (Bearer token)
TWITTER_BEARER_TOKEN=
